{
  "name": "@dsh-family/kit",
  "version": "0.2.1",
  "description": "Shared primitives for dsh plugins: atomic full-file writes, the GitHub REST fetch path used by the scanning plugins, and the mock-ctx harness every plugin test builds on.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./kit/fs": {
      "types": "./lib/types/kit/fs.d.ts",
      "default": "./lib/kit/fs.js"
    },
    "./package.json": "./package.json",
    "./kit/http": {
      "types": "./lib/types/kit/http.d.ts",
      "default": "./lib/kit/http.js"
    },
    "./kit/test-harness": {
      "types": "./lib/types/kit/test-harness.d.ts",
      "default": "./lib/kit/test-harness.js"
    }
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "kit"
  ],
  "dsh": {
    "role": "shared-lib"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "kit",
    "atomic-write",
    "shared",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/121212165/dsh-plugin-kit.git"
  },
  "sideEffects": false,
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.2"
  }
}
